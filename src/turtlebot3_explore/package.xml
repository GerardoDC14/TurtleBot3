<?xml version="1.0"?>
<package format="3">
  <name>turtlebot3_explore</name>
  <version>0.1.0</version>
  <description>Python frontier-exploration mission node using occupancy-grid processing, TF and Nav2 goal execution.</description>
  <maintainer email="123440177+GerardoDC14@users.noreply.github.com">Gerardo Escobar</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>nav2_simple_commander</depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
